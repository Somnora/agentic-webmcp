{
  "name": "agentic-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source WebMCP commerce tools for human-agent catalog collaboration.",
  "homepage": "https://agentic-webmcp.somnora.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Somnora/agentic-webmcp.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && wrangler deploy --dry-run && wrangler deploy --config wrangler.origin.jsonc --dry-run",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5",
    "wrangler": "^4.125.0"
  }
}
